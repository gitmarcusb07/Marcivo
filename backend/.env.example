# Copy to .env and fill in
PORT=3001
FRONTEND_ORIGIN=*

# TMDB (you said key is ready)
TMDB_API_KEY=
TMDB_BASE=https://api.themoviedb.org/3
TMDB_IMAGE=https://image.tmdb.org/t/p/w500

# AniList (no key needed, GraphQL)
ANILIST_ENDPOINT=https://graphql.anilist.co
ANILIST_CACHE=300

# --- Website search (SITE1-3 originals, SITE4 streaming-slot movies/series priority, SITE5 PirateXPlay anime priority, SITE6 BoredFlix extra movie/series provider, SITE7 Cinejoy default-first streaming provider) ---
# NOTE: prmovies.org.in is a blog clone (articles, no playable content). The
# scraper filters its article links, so SITE4 reports 0 until SITE4_BASE_URL
# points at a real WP-style streaming mirror. prmoviestv.cfd is JS-rendered
# (cheerio can't read its search). Swap SITE4 freely — priority stays central.
# Optional per-site hardening: SITE{n}_STRICT_TITLE=true drops result titles
# without a year/quality tag (anti-blog-clone; set it if a slot points at a
# blog clone like prmovies.org.in). Off by default.
# Origin routing (TMDB original_language, no extra API cost):
HOLLYWOOD_SITES=1
BOLLYWOOD_SITES=2
SITE_SEARCH_ENABLED=true
# Exclusive provider (default flow): movie/series search AND playback
# resolve through this SINGLE site slot — caller-supplied pools (origin
# routing, group pools, frontend lists) are ignored for non-anime queries.
# Anime keeps its own pool. Default 4 (the streaming slot, currently
# Cinegram). Set 0 to restore legacy multi-provider routing — in that mode
# Cinejoy (slot 7) is searched FIRST for movies/series and the pools below
# stay the fallback order. Set 7 to make Cinejoy the exclusive provider.
EXCLUSIVE_SITE=4
SITE1_BASE_URL=https://vegamovies.gallery
SITE1_SEARCH_PATH=/ts-search.php?q={query}&page=1
SITE1_NAME=Vegamovies
SITE2_BASE_URL=https://n1.rogmovies.best
SITE2_SEARCH_PATH=/ts-search.php?q={query}&page=1
SITE2_NAME=RogMovies
SITE3_BASE_URL=https://gokuhd.com
SITE3_SEARCH_PATH=/search.php?q={query}&page=1
SITE3_NAME=Gokuhd
SITE4_BASE_URL=https://prmovies.org.in
SITE4_SEARCH_PATH=/?s={query}
SITE4_NAME=PRMovies
SITE5_BASE_URL=https://piratexplay.cc
SITE5_SEARCH_PATH=/?s={query}
SITE5_NAME=PirateXPlay
# SITE6 = BoredFlix (https://boredflix.mobi) — additional streaming provider
# for movies/series. Parsed through the card-grid adapter against its verified
# DOM (results = aside.main item cards: .poster img[data-src] poster,
# .meta year/type/title). Joins the movie/series + unknown pools at the LOWEST
# priority (existing sources never shift), participates only in multi-provider
# mode (EXCLUSIVE_SITE=0), and is inert while SITE6_BASE_URL is empty.
SITE6_BASE_URL=https://boredflix.mobi
SITE6_SEARCH_PATH=/?s={query}
SITE6_NAME=BoredFlix
# SITE7 = Cinejoy (https://cinejoy.pk) — TMDB-backed streaming provider,
# FIRST priority for movies/series in multi-provider mode (EXCLUSIVE_SITE=0)
# and inert while SITE7_BASE_URL is empty. Its /search page is a client-side
# app that queries TMDB in the browser (verified against the live site), so
# the backend adapter mirrors that client: results come from TMDB search
# (needs TMDB_API_KEY) mapped onto Cinejoy page URLs. The search path below
# is the site's own (human) search URL; server-side fetching it returns the
# empty app shell, which is why the adapter reads TMDB instead. Playback
# resolves through the site's public /watch/… player (see WATCH_CINEJOY_*).
SITE7_BASE_URL=https://cinejoy.pk
SITE7_SEARCH_PATH=/search?q={query}
SITE7_NAME=Cinejoy
SITE_TIMEOUT=15
SITE_MAX_RESULTS_PER_SITE=10
SITE_MAX_RESULTS_TOTAL=30
SITE_SEARCH_CACHE=600
SITE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)

# --- Resolver (Playwright, persistent browser) ---
WATCH_ENABLED=true
WATCH_HEADLESS=true
WATCH_NAV_TIMEOUT=15
WATCH_VCLOUD_DOMAINS=nexdrive.fit,vcloud.fit
# Cinegram embed lane: hosts served by the source's own player embed
# (comma-separated mirrors; the lane is inert when no host matches).
WATCH_CINEGRAM_HOSTS=cinegram.tv
# Cinejoy public-player lane: hosts served by the site's own /watch/… player
# (X-Frame-Options: DENY — not embeddable). The lane drives that public page
# in the browser like a viewer and captures only the HLS URL its player
# requests, validating it before serving. Budget = max seconds to wait for
# the stream to appear (the site takes ~10-15s).
WATCH_CINEJOY_HOSTS=cinejoy.pk
WATCH_CINEJOY_BUDGET=60
RESOLVE_CACHE_TTL=21600
RESOLVE_MAX_JOBS=1

# --- Fast Watch: temporary stream cache + background pre-resolution ---
STREAM_CACHE_TTL=7200
STREAM_REFRESH_THRESHOLD=900
RESOLVER_TIMEOUT=150
# Background budget: vcloud countdowns need ~60-90s; reservation protects taps.
RESOLVER_BG_TIMEOUT=120
# 3 parallel (2 background + 1 always reserved for user taps).
RESOLVER_MAX_CONCURRENCY=3
# 2 max: 3 pre-resolves filled all 3 slots and user taps queued behind them.
PRE_RESOLVE_LIMIT=2
