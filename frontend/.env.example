# ── Backend API ────────────────────────────────────────────────────────────
# Render service URL, no trailing slash. Baked into the JS bundle at build
# time — changing it requires a Cloudflare Pages rebuild.
VITE_API=https://YOUR-SERVICE.onrender.com

# ── Ads (Adstra / Adsterra) ────────────────────────────────────────────────
# "1" = show ads, "0" = hide every ad slot. Paste the actual unit snippets in
# src/ads/config.ts — see ADS.md.
VITE_ADS_ENABLED=1
# Site-wide network loader URL (optional — only if your network gives one):
VITE_AD_LOADER_SRC=
